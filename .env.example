# Salin menjadi .env. Ini contoh MongoDB lokal, bukan server yang otomatis dibuat.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=bootcamp_profiling_clean_01
PROFILING_WINDOW_MONTHS=3
# Lokal: profiling berjalan pada port 8011. Podman/OpenShift override ke Service DNS.
PROFILING_SERVICE_URL=http://127.0.0.1:8011

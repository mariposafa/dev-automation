# Salin ke manifest/secret.yaml, lalu isi URI milikmu. Jangan commit file hasilnya.
# Jangan apply template ini sebelum placeholder diganti.
apiVersion: v1
kind: Secret
metadata:
  name: transaction-secret
  namespace: nabilahsafa-dev
type: Opaque
stringData:
  MONGODB_URI: "GANTI_DENGAN_URI_MONGODB"
